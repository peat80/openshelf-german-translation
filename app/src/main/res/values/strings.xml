    <string name="set_accent">Accent colour</string>
    <string name="set_accent_help">Colours the focus ring, the focused button and the dot that marks installed apps. Press OK to try the next one.</string>
    <string name="set_appearance">Appearance</string>
    <string name="set_appearance_help">Light hangs the shelf on a white wall, Dark on a charcoal one for evenings. Match TV follows the TV’s own dark setting. Press OK to switch.</string>
    <string name="set_install">Install apps from Open Shelf</string>
    <string name="allowed">Allowed</string>
    <string name="not_allowed">Not allowed yet</string>
    <string name="set_install_help">Android asks you to allow this once. After that, Open Shelf can install and update apps, and each install still asks you to confirm.</string>
    <string name="set_apk">APK type</string>
    <string name="apk_auto">Automatic · %1$s</string>
    <string name="set_apk_help">Many apps publish a different file for each kind of chip. Open Shelf picks the one that fits this TV. Supported here: %1$s.</string>
    <string name="set_key">If an app’s signing key changes</string>
    <string name="set_key_value">Hold the update</string>
    <string name="set_key_help">Every release is signed by its developer. If a new file is signed by someone else, Open Shelf keeps your current version and doesn’t install it.</string>
    <string name="set_catalog">Catalog</string>
    <string name="catalog_value">%1$s apps · %2$s</string>
    <string name="catalog_help">Every Android TV app on GitHub that publishes an APK and has had a release in the last 3 years. Checked on %1$s. This version carries the list inside the app.</string>
    <string name="set_stars">Hide apps with fewer stars than</string>
    <string name="set_stars_help">Keeps very new or little-used apps out of Discover. %1$s apps are hidden. Search still finds them by their exact name.</string>
    <string name="set_streams">Hide IPTV and stream apps</string>
    <string name="streams_on">On · %1$s hidden</string>
    <string name="streams_off">Off</string>
    <string name="set_streams_help">Hides IPTV players, live TV channel apps and debrid, torrent or Stremio streaming clients. They’re open source, but they play streams you bring yourself. Press OK to switch.</string>
    <string name="set_cache">Download cache</string>
    <string name="cache_value">%1$s · Clear</string>
    <string name="set_cache_help">Downloaded APK files are kept here so you can reinstall without downloading again. Press OK to clear them.</string>
    <string name="set_about">About</string>
    <string name="about_value">Open Shelf %1$s</string>
    <string name="about_help">Open Shelf is open source under GPL-3.0, at github.com/wingedpanther/openshelf. App names, art and releases come from each project’s GitHub repository.</string>
